# Copy this file to .env: cp .env.example .env
# Never commit .env. Replace every value marked CHANGE_ME.

# Get this token from @BotFather after creating the bot.
BOT_TOKEN=CHANGE_ME_PASTE_BOTFATHER_TOKEN_HERE

# Get this token from the BotoHub dashboard for this bot.
BOTOHUB_TOKEN=CHANGE_ME_PASTE_BOTOHUB_TOKEN_HERE

# Optional: API key from @tgrassbot. Leave empty to disable Tgrass offers/tasks.
TGRASS_TOKEN=

# Your personal numeric Telegram ID (not the bot ID). Multiple IDs: 123,456
ADMIN_IDS=CHANGE_ME_PASTE_YOUR_TELEGRAM_ID

# Mandatory subscriptions requested from BotoHub (allowed range: 1..30).
MAX_OP=20

# PostgreSQL credentials used by the Docker Compose stack. Choose a long random password.
POSTGRES_USER=opbot
POSTGRES_DB=opbot
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://opbot:CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/opbot

# Redis is optional for the current application, but Compose provides it for future FSM/rate limits.
REDIS_URL=redis://redis:6379/0
